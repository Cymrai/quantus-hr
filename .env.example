# ─── App ───────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://quantus:quantus@localhost:5432/quantus_hr
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=quantus
DATABASE_PASSWORD=quantus
DATABASE_NAME=quantus_hr

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Elasticsearch ─────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Auth ──────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Storage (S3 / compatible) ─────────────────────
S3_BUCKET=quantus-hr-dev
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ─── Web app ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── Email ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@quantushr.com
